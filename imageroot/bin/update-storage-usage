# Calculate the disk space used by the collected logs and metrics and write it
# to storage-usage/storage-usage.json, read by the API server.
# It must be executed inside the module state directory.

import json
import os
import subprocess
import sys
import tempfile
import time

OUTPUT_DIR = 'storage-usage'
OUTPUT_FILE = os.path.join(OUTPUT_DIR, 'storage-usage.json')

# map each data type to the Podman volume that stores it
VOLUMES = {
    'logs_storage_bytes': 'loki-data',
    'system_metrics_storage_bytes': 'prometheus-data',
    'traffic_metrics_storage_bytes': 'timescale-data',
}


def volume_size(volume):
    """Return the disk space used by a Podman volume in bytes, 0 if the volume does not exist."""
    inspect = subprocess.run(['podman', 'volume', 'inspect', '--format', '{{.Mountpoint}}', volume],
                             capture_output=True, text=True)
    if inspect.returncode != 0:
        print(f'Volume {volume} not found, assuming it is empty', file=sys.stderr)
        return 0
    mountpoint = inspect.stdout.strip()
    # Files are owned by the container users: run du inside the user namespace to read all of them
    du = subprocess.run(['podman', 'unshare', 'du', '--summarize', '--block-size=1', mountpoint],
                        capture_output=True, text=True, check=True)
    return int(du.stdout.split()[0])


usage = {key: volume_size(volume) for key, volume in VOLUMES.items()}
usage['total_storage_bytes'] = sum(usage.values())
usage['storage_updated_at'] = int(time.time())

os.makedirs(OUTPUT_DIR, exist_ok=True)
# write to a temporary file and rename it, so the API server never reads a partial file
with tempfile.NamedTemporaryFile('w', dir=OUTPUT_DIR, delete=False) as tmp:
    json.dump(usage, tmp)
os.chmod(tmp.name, 0o644)
os.replace(tmp.name, OUTPUT_FILE)
