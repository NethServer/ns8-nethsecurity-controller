# Recent kernels refuse a rootless container to open a tun without owner.
# A tun created by an older core has no owner: recreate it so the core
# gives it to this module.

import os
import sys
import json
import subprocess
import agent

network = agent.read_envfile('network.env')
tun = network.get('OVPN_TUN')
if not tun:
    sys.exit(0)

def read_owner():
    try:
        with open(f'/sys/class/net/{tun}/owner') as fp:
            return int(fp.read())
    except (OSError, ValueError):
        return None

owner = read_owner()
# No tun yet (module not configured) or already owned by this module
if owner is None or owner == os.getuid():
    sys.exit(0)

addr = json.loads(subprocess.run(['ip', '-j', '-4', 'addr', 'show', 'dev', tun], capture_output=True, text=True, check=True).stdout)
info = addr[0]['addr_info'][0]
ip = f"{info['local']}/{info['prefixlen']}"

was_active = subprocess.run(['systemctl', '--user', 'is-active', '--quiet', 'controller.service']).returncode == 0
# The VPN holds the tun, and vpn.service is bound to controller.service
subprocess.run(['systemctl', '--user', 'stop', 'controller.service'], check=True)
agent.assert_exp(agent.remove_tun(tun))
agent.assert_exp(agent.add_tun(tun, ip))
if was_active:
    subprocess.run(['systemctl', '--user', 'start', 'controller.service'], check=True)

if read_owner() != os.getuid():
    print(agent.SD_WARNING + f'The tun {tun} still has no owner: the core is too old to set it', file=sys.stderr)
